#!/bin/bash

# QuestLab Help System
# Quick reference for all available commands

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

show_help() {
    local category=$1
    
    clear
    echo -e "${CYAN}"
    echo "╔════════════════════════════════════════════════════════════════╗"
    echo "║              🎓 QuestLab Command Reference 🎓                  ║"
    echo "╚════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}\n"
    
    case $category in
        docker|d)
            echo -e "${WHITE}🐳 Docker Commands:${NC}\n"
            echo -e "${GREEN}Basic Control:${NC}"
            echo "  qup              Start all services"
            echo "  qdown            Stop all services"
            echo "  qrestart         Restart all services"
            echo "  qrebuild         Rebuild and restart"
            echo "  qstatus          Show service status"
            echo ""
            echo -e "${GREEN}HTTP Mode:${NC}"
            echo "  qup-http         Start in HTTP mode"
            echo "  qdown-http       Stop HTTP mode"
            echo "  qrestart-http    Restart HTTP mode"
            echo ""
            echo -e "${GREEN}Logs:${NC}"
            echo "  logs             View all logs (live)"
            echo "  logb             Backend logs only"
            echo "  logdb            Database logs only"
            echo "  logn             Nginx logs only"
            echo "  logall           All logs (last 100 lines)"
            echo ""
            echo -e "${GREEN}Access Containers:${NC}"
            echo "  qdb              Shell into database"
            echo "  qbe              Shell into backend"
            echo "  qfe              Shell into nginx"
            echo ""
            echo -e "${GREEN}Monitoring:${NC}"
            echo "  dstats           Resource usage"
            echo "  dspace           Disk space usage"
            echo "  dps              Running containers"
            echo ""
            echo -e "${GREEN}Cleanup:${NC}"
            echo "  dclean           Full cleanup (dangerous!)"
            echo "  dclean-safe      Safe cleanup"
            echo "  dstop-all        Stop all containers"
            ;;
            
        database|db)
            echo -e "${WHITE}🗄️  Database Commands:${NC}\n"
            echo -e "${GREEN}Access:${NC}"
            echo "  psql             Open PostgreSQL shell"
            echo "  psqlshell        Bash shell in database container"
            echo ""
            echo -e "${GREEN}Data Management:${NC}"
            echo "  questlab_clean_seed.sql            Load seed data"
            echo "  load-seed        Run seed data script"
            echo "  db-backup        Backup database"
            echo "  db-restore FILE  Restore from backup"
            echo ""
            echo -e "${GREEN}Quick Queries:${NC}"
            echo "  list-users       Show all users"
            echo "  list-lessons     Show all lessons"
            echo "  count-users      Count users by role"
            echo "  show-tables      List all tables"
            echo "  db-size          Show database size"
            echo ""
            echo -e "${GREEN}SQL Examples:${NC}"
            echo "  SELECT * FROM users WHERE role='admin';"
            echo "  UPDATE users SET role='teacher' WHERE id=1;"
            echo "  DELETE FROM lessons WHERE id=5;"
            ;;
            
        deploy|deployment)
            echo -e "${WHITE}🚀 Deployment Commands:${NC}\n"
            echo -e "${GREEN}Main Scripts:${NC}"
            echo "  deploy           Quick start deployment"
            echo "  verify           Verify deployment"
            echo "  fix-db           Fix database issues"
            echo ""
            echo -e "${GREEN}SSL/HTTPS:${NC}"
            echo "  init-ssl         Initialize SSL certificates"
            echo "  use-ssl          Use existing certificates"
            echo ""
            echo -e "${GREEN}Health Checks:${NC}"
            echo "  health           Check backend health"
            echo "  health-all       Check all services"
            echo ""
            echo -e "${GREEN}Deployment Steps:${NC}"
            echo "  1. Ensure .env file is configured"
            echo "  2. Run: deploy"
            echo "  3. Wait for services to start"
            echo "  4. Run: verify"
            echo "  5. Access your site!"
            ;;
            
        git|g)
            echo -e "${WHITE}📝 Git Commands:${NC}\n"
            echo -e "${GREEN}Basic:${NC}"
            echo "  gs               Git status"
            echo "  ga FILE          Add file"
            echo "  gaa              Add all files"
            echo "  gc 'message'     Commit with message"
            echo "  gp               Push to remote"
            echo "  gpull            Pull from remote"
            echo "  gl               Pretty log graph"
            echo "  gd               Show diff"
            echo ""
            echo -e "${GREEN}Quick Commands:${NC}"
            echo "  gsave            Quick save (add+commit+push)"
            echo "  gbackup          Backup with timestamp"
            echo "  gquick 'msg'     Quick commit with custom message"
            echo ""
            echo -e "${GREEN}Workflow:${NC}"
            echo "  1. Make changes"
            echo "  2. gs (check status)"
            echo "  3. gaa (add all)"
            echo "  4. gc 'your message'"
            echo "  5. gp (push)"
            ;;
            
        network|net)
            echo -e "${WHITE}🌐 Network Commands:${NC}\n"
            echo -e "${GREEN}Information:${NC}"
            echo "  myip             Show public IP"
            echo "  localip          Show local IP"
            echo "  ports            Show open ports"
            echo "  check-port PORT  Check specific port"
            echo ""
            echo -e "${GREEN}Testing:${NC}"
            echo "  test-http        Test HTTP connection"
            echo "  test-api         Test API endpoint"
            echo "  test-dns         Test DNS resolution"
            echo "  ping-google      Ping Google DNS"
            echo ""
            echo -e "${GREEN}Port Management:${NC}"
            echo "  kill-port PORT   Kill process on port"
            echo "  fix-ports        Clear ports 80 & 443"
            echo ""
            echo -e "${GREEN}Firewall:${NC}"
            echo "  fix-firewall     Configure firewall rules"
            ;;
            
        system|sys)
            echo -e "${WHITE}⚙️  System Commands:${NC}\n"
            echo -e "${GREEN}Resources:${NC}"
            echo "  cpu              Show CPU usage"
            echo "  mem              Show memory usage"
            echo "  disk             Show disk usage"
            echo "  usage            Show directory sizes"
            echo ""
            echo -e "${GREEN}Navigation:${NC}"
            echo "  q                Go to questlab root"
            echo "  qback            Go to backend"
            echo "  qfront           Go to frontend"
            echo "  ..               Up one directory"
            echo "  ...              Up two directories"
            echo ""
            echo -e "${GREEN}File Operations:${NC}"
            echo "  ll               Detailed list"
            echo "  lt               List by time"
            echo "  lsize            List by size"
            echo "  count            Count files"
            echo "  size             Directory size"
            ;;
            
        maintenance|fix)
            echo -e "${WHITE}🔧 Maintenance Commands:${NC}\n"
            echo -e "${GREEN}Fixes:${NC}"
            echo "  fix-perms        Fix file permissions"
            echo "  fix-firewall     Configure firewall"
            echo "  fix-ports        Clear stuck ports"
            echo "  fix-db           Fix database"
            echo ""
            echo -e "${GREEN}Service Control:${NC}"
            echo "  restart-backend  Restart backend only"
            echo "  restart-nginx    Restart nginx only"
            echo "  restart-db       Restart database only"
            echo ""
            echo -e "${GREEN}Configuration:${NC}"
            echo "  show-env         Show environment variables"
            echo "  show-config      Show configuration"
            ;;
            
        python|py)
            echo -e "${WHITE}🐍 Python Commands:${NC}\n"
            echo -e "${GREEN}Virtual Environment:${NC}"
            echo "  venv             Create virtual environment"
            echo "  pa               Activate environment"
            echo "  pd               Deactivate environment"
            echo ""
            echo -e "${GREEN}Package Management:${NC}"
            echo "  req              Create requirements.txt"
            echo "  install          Install from requirements.txt"
            echo "  py               Run Python 3"
            echo "  ipy              Run IPython"
            ;;
            
        tmux|t)
            echo -e "${WHITE}⚡ Tmux Commands:${NC}\n"
            echo -e "${GREEN}Sessions:${NC}"
            echo "  questlab         Create/attach to main session"
            echo "  qsession         Create split-pane session"
            echo "  ta NAME          Attach to session"
            echo "  tl               List sessions"
            echo "  tk NAME          Kill session"
            echo ""
            echo -e "${GREEN}Tmux Keys (Ctrl+B then):${NC}"
            echo "  %                Split vertically"
            echo "  \"                Split horizontally"
            echo "  Arrow            Switch panes"
            echo "  d                Detach session"
            echo "  c                New window"
            echo "  n                Next window"
            ;;
            
        all|*)
            echo -e "${WHITE}📚 All Command Categories:${NC}\n"
            echo -e "${CYAN}Usage:${NC} qhelp [category]\n"
            echo -e "${GREEN}Available Categories:${NC}"
            echo "  docker (d)       Docker and container management"
            echo "  database (db)    Database operations"
            echo "  deploy           Deployment commands"
            echo "  git (g)          Git version control"
            echo "  network (net)    Network and connectivity"
            echo "  system (sys)     System utilities"
            echo "  maintenance      Fixes and maintenance"
            echo "  python (py)      Python environment"
            echo "  tmux (t)         Terminal multiplexer"
            echo ""
            echo -e "${CYAN}Examples:${NC}"
            echo "  qhelp docker     Show all Docker commands"
            echo "  qhelp db         Show database commands"
            echo "  qhelp git        Show Git commands"
            echo ""
            echo -e "${CYAN}Quick Start:${NC}"
            echo "  menu             Launch interactive TUI"
            echo "  qup              Start QuestLab"
            echo "  logs             View logs"
            echo "  health           Check health"
            echo ""
            echo -e "${YELLOW}💡 Tip:${NC} Type 'menu' for an interactive interface!"
            ;;
    esac
    
    echo ""
}

# Main execution
if [ $# -eq 0 ]; then
    show_help all
else
    show_help "$1"
fi
