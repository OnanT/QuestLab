# ============================================
# 🔧 UTILITY FUNCTIONS
# ============================================

# Create quick note
qnote() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> ~/opt/questlab/notes.txt
    echo "Note saved!"
}


# Quick backup
qbackup() {
    local backup_name="questlab_backup_$(date +%Y%m%d_%H%M%S)"
    tar -czf ~/backups/${backup_name}.tar.gz \
        --exclude='node_modules' \
        --exclude='__pycache__' \
        --exclude='.venv' \
        ~/questlab/
    echo "Backup created: ~/backups/${backup_name}.tar.gz"
}

# Watch a command continuously
qwatch() {
    watch -n ${2:-2} "$1"
}

# Follow log files
qtail() {
    tail -f ${1:-/var/log/syslog}
}

