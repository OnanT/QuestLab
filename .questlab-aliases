# ============================================
# 🐳 DOCKER - QUESTLAB SPECIFIC
# ============================================

# Basic Docker
alias d='docker'
alias dc='docker compose'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dpsa='docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.CreatedAt}}"'
alias di='docker images'

# QuestLab Containers Quick Access
alias qdb='docker exec -it questlab_postgres bash'
alias qbe='docker exec -it questlab_backend bash'
alias qfe='docker exec -it questlab_nginx bash'

# QuestLab Logs (Super Fast)
alias logs='docker compose logs -f'
alias logb='docker compose logs -f backend'
alias logdb='docker compose logs -f postgres'
alias logn='docker compose logs -f nginx'
alias logall='docker compose logs -f --tail=100'

# QuestLab Control
alias qup='docker compose up -d'
alias qdown='docker compose down'
alias qrestart='docker compose restart'
alias qrebuild='docker compose down && docker compose build --no-cache && docker compose up -d'
alias qstatus='docker compose ps'
alias qbuild='docker compose build'

# QuestLab HTTP mode
alias qup-http='docker compose -f docker-compose-http.yml up -d'
alias qdown-http='docker compose -f docker-compose-http.yml down'
alias qrestart-http='docker compose -f docker-compose-http.yml restart'
alias qstatus-http='docker compose -f docker-compose-http.yml ps'

# Quick service restart
alias restart-backend='docker compose restart backend'
alias restart-nginx='docker compose restart nginx'
alias restart-db='docker compose restart postgres'

# Docker cleanup
alias dclean='docker system prune -af --volumes'
alias dclean-safe='docker system prune -f'
alias dstop-all='docker stop $(docker ps -aq)'
alias drm-all='docker rm $(docker ps -aq)'

# Docker stats
alias dstats='docker stats --format "table {{.Container}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}"'
alias dspace='docker system df -v'

# ============================================
# 🗄️ DATABASE - POSTGRESQL
# ============================================

# Quick database access
alias psql='docker exec -it questlab_postgres psql -U turtle_guide -d questlab_db'
alias psqlshell='docker exec -it questlab_postgres bash'
alias pgdump='docker exec questlab_postgres pg_dump -U turtle_guide questlab_db'

# Database operations
alias db-backup='docker exec questlab_postgres pg_dump -U turtle_guide questlab_db > backup_$(date +%Y%m%d_%H%M%S).sql'
alias db-restore='function _dbrestore() { docker exec -i questlab_postgres psql -U turtle_guide -d questlab_db < "$1"; }; _dbrestore'
alias db-dump-all='docker exec questlab_postgres pg_dumpall -U turtle_guide > alldb_backup_$(date +%Y%m%d_%H%M%S).sql'

# Seed data
alias seed='docker exec -i questlab_postgres psql -v ON_ERROR_STOP=1 -U turtle_guide -d questlab_db < questlab_clean_seed.sql'
alias load-seed='./load-seed-data.sh'

# Quick queries
alias list-users='docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT id, username, email, role FROM users;"'
alias list-lessons='docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT id, title, subject, grade_level FROM lessons;"'
alias count-users='docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT role, COUNT(*) FROM users GROUP BY role;"'
alias db-size='docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT pg_size_pretty(pg_database_size(current_database()));"'

# Table info
alias show-tables='docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "\dt"'
alias describe-users='docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "\d users"'

