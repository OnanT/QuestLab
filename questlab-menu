# Docker management menu
docker_menu() {
    while true; do
        print_header
        echo -e "${WHITE}━━━━━━━━━ 🐳 Docker Management ━━━━━━━━━━${NC}"
        echo ""
        echo -e "  ${GREEN}[1]${NC} Start All Services"
        echo -e "  ${GREEN}[2]${NC} Stop All Services"
        echo -e "  ${GREEN}[3]${NC} Restart All Services"
        echo -e "  ${GREEN}[4]${NC} Rebuild Containers"
        echo -e "  ${GREEN}[5]${NC} View Container Status"
        echo -e "  ${GREEN}[6]${NC} View Container Stats"
        echo -e "  ${GREEN}[7]${NC} Shell into Backend"
        echo -e "  ${GREEN}[8]${NC} Shell into Database"
        echo -e "  ${GREEN}[9]${NC} Shell into Nginx"
        echo -e "  ${YELLOW}[10]${NC} Clean Docker System"
        echo ""
        echo "  ${RED}[0]${NC} Back to Main Menu"
        echo ""
        read -p "Select option: " choice
        
        case $choice in
            1)
                print_info "Starting all services..."
                docker compose up -d
                print_success "Services started!"
                pause
                ;;
            2)
                print_info "Stopping all services..."
                docker compose down
                print_success "Services stopped!"
                pause
                ;;
            3)
                print_info "Restarting all services..."
                docker compose restart
                print_success "Services restarted!"
                pause
                ;;
            4)
                print_warning "This will rebuild all containers from scratch"
                read -p "Continue? (y/n) " confirm
                if [[ $confirm == "y" ]]; then
                    docker compose down
                    docker compose build --no-cache
                    docker compose up -d
                    print_success "Rebuild complete!"
                fi
                pause
                ;;
            5)
                docker compose ps
                pause
                ;;
            6)
                echo "Showing container stats (Ctrl+C to exit)..."
                docker stats
                ;;
            7)
                docker exec -it questlab_backend bash
                ;;
            8)
                docker exec -it questlab_postgres bash
                ;;
            9)
                docker exec -it questlab_nginx bash
                ;;
            10)
                print_warning "This will remove all stopped containers and unused images"
                read -p "Continue? (y/n) " confirm
                if [[ $confirm == "y" ]]; then
                    docker system prune -f
                    print_success "Cleanup complete!"
                fi
                pause
                ;;
            0)
                return
                ;;
            *)
                print_error "Invalid option"
                sleep 1
                ;;
        esac
    done
}

# Database menu
database_menu() {
    while true; do
        print_header
        echo -e "${WHITE}━━━━━━━━━ 🗄️  Database Operations ━━━━━━━━━━${NC}"
        echo ""
        echo -e "  ${GREEN}[1]${NC} Access PostgreSQL Shell"
        echo -e "  ${GREEN}[2]${NC} Load Seed Data"
        echo -e "  ${GREEN}[3]${NC} List Users"
        echo -e "  ${GREEN}[4]${NC} List Lessons"
        echo -e "  ${GREEN}[5]${NC} Count Users by Role"
        echo -e "  ${GREEN}[6]${NC} Show All Tables"
        echo -e "  ${GREEN}[7]${NC} Database Size"
        echo -e "  ${GREEN}[8]${NC} Backup Database"
        echo -e "  ${GREEN}[9]${NC} Restore Database"
        echo ""
        echo -e "  ${RED}[0]${NC} Back to Main Menu"
        echo ""
        read -p "Select option: " choice
        
        case $choice in
            1)
                print_info "Connecting to PostgreSQL..."
                docker exec -it questlab_postgres psql -U turtle_guide -d questlab_db
                ;;
            2)
                if [ -f "questlab_clean_seed.sql" ]; then
                    print_info "Loading seed data..."
                    docker exec -i questlab_postgres psql -v ON_ERROR_STOP=1 -U turtle_guide -d questlab_db < questlab_clean_seed.sql
                    print_success "Seed data loaded!"
                else
                    print_error "questlab_clean_seed.sql not found"
                fi
                pause
                ;;
            3)
                docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT id, username, email, role FROM users;"
                pause
                ;;
            4)
                docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT id, title, subject, grade_level FROM lessons;"
                pause
                ;;
            5)
                docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT role, COUNT(*) FROM users GROUP BY role;"
                pause
                ;;
            6)
                docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "\dt"
                pause
                ;;
            7)
                docker exec questlab_postgres psql -U turtle_guide -d questlab_db -c "SELECT pg_size_pretty(pg_database_size(current_database()));"
                pause
                ;;
            8)
                local backup_file="backup_$(date +%Y%m%d_%H%M%S).sql"
                print_info "Creating backup: $backup_file"
                docker exec questlab_postgres pg_dump -U turtle_guide questlab_db > "$backup_file"
                print_success "Backup saved to $backup_file"
                pause
                ;;
            9)
                read -p "Enter backup file path: " backup_file
                if [ -f "$backup_file" ]; then
                    docker exec -i questlab_postgres psql -U turtle_guide -d questlab_db < "$backup_file"
                    print_success "Database restored!"
                else
                    print_error "Backup file not found"
                fi
                pause
                ;;
            0)
                return
                ;;
            *)
                print_error "Invalid option"
                sleep 1
                ;;
        esac
    done
}

