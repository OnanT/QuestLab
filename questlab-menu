# System info menu
system_info() {
    print_header
    echo -e "${WHITE}━━━━━━━━━ ⚙️  System Information ━━━━━━━━━━${NC}"
    echo ""
    
    echo -e "${CYAN}System:${NC}"
    echo "  OS: $(uname -s)"
    echo "  Kernel: $(uname -r)"
    echo "  Hostname: $(hostname)"
    echo ""
    
    echo -e "${CYAN}Resources:${NC}"
    echo "  CPU Usage: $(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1"%"}')"
    free -h | grep "Mem:" | awk '{print "  Memory: " $3 " / " $2 " (" int($3/$2*100) "%)"}'
    df -h / | tail -1 | awk '{print "  Disk: " $3 " / " $2 " (" $5 ")"}'
    echo ""
    
    echo -e "${CYAN}Docker:${NC}"
    docker --version
    docker compose version
    echo ""
    
    echo -e "${CYAN}Network:${NC}"
    echo "  Public IP: $(curl -s ifconfig.me 2>/dev/null || echo 'unknown')"
    echo "  Local IP: $(hostname -I | awk '{print $1}')"
    echo ""
    
    pause
}

# Main loop
main() {
    while true; do
        show_main_menu
        read -p "Select option: " choice
        
        case $choice in
            1) deployment_menu ;;
            2) docker_menu ;;
            3) database_menu ;;
            4) monitoring_menu ;;
            5) maintenance_menu ;;
            6) network_menu ;;
            7) git_menu ;;
            8) help_menu ;;
            9) system_info ;;
            0)
                clear
                echo -e "${CYAN}"
                echo "╔════════════════════════════════════════╗"
                echo "║       Thanks for using QuestLab!      ║"
                echo "║         Happy Teaching! 🎓            ║"
                echo "╚════════════════════════════════════════╝"
                echo -e "${NC}"
                exit 0
                ;;
            *)
                print_error "Invalid option"
                sleep 1
                ;;
        esac
    done
}

# Run the menu
main
