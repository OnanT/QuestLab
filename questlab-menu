#!/bin/bash

# QuestLab Interactive TUI Menu
# A beautiful terminal interface for managing your QuestLab deployment

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# Unicode box characters
TL='╔'  # Top Left
TR='╗'  # Top Right
BL='╚'  # Bottom Left
BR='╝'  # Bottom Right
H='═'   # Horizontal
V='║'   # Vertical
VR='╠'  # Vertical Right
VL='╣'  # Vertical Left
HU='╩'  # Horizontal Up
HD='╦'  # Horizontal Down
C='╬'   # Cross

# Helper functions
print_header() {
    clear
    echo -e "${CYAN}"
    echo "${TL}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${TR}"
    echo "${V}                  🎓 QuestLab Control Center 🎓                  ${V}"
    echo "${V}                 Interactive Management Console                 ${V}"
    echo "${BL}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${H}${BR}"
    echo -e "${NC}"
}

print_box() {
    local text="$1"
    local color="${2:-$WHITE}"
    local length=${#text}
    local padding=4
    local total=$((length + padding * 2))
    
    echo -e "${color}"
    echo -n "${TL}"
    printf '%*s' "$total" | tr ' ' "${H}"
    echo "${TR}"
    echo "${V}$(printf '%*s' $padding)${text}$(printf '%*s' $padding)${V}"
    echo -n "${BL}"
    printf '%*s' "$total" | tr ' ' "${H}"
    echo "${BR}"
    echo -e "${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

pause() {
    echo ""
    read -p "Press Enter to continue..."
}

# Status check functions
check_containers() {
    if docker ps --format '{{.Names}}' | grep -q "questlab"; then
        return 0
    else
        return 1
    fi
}

get_container_status() {
    local container=$1
    if docker ps --format '{{.Names}}' | grep -q "$container"; then
        echo -e "${GREEN}●${NC} Running"
    elif docker ps -a --format '{{.Names}}' | grep -q "$container"; then
        echo -e "${RED}●${NC} Stopped"
    else
        echo -e "${YELLOW}●${NC} Not Found"
    fi
}

