        echo -e "  ${GREEN}[5]${NC} Use Existing SSL"
        echo -e "  ${GREEN}[6]${NC} Verify Deployment"
        echo -e "  ${GREEN}[7]${NC} Fix Database Setup"
        echo ""
        echo "  ${RED}[0]${NC} Back to Main Menu"
