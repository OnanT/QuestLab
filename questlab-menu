# Maintenance menu
maintenance_menu() {
    while true; do
        print_header
        echo -e "${WHITE}━━━━━━━━━ 🔧 Maintenance & Fixes ━━━━━━━━━━${NC}"
        echo ""
        echo -e "  ${GREEN}[1]${NC} Fix File Permissions"
        echo -e "  ${GREEN}[2]${NC} Fix Firewall Rules"
        echo -e "  ${GREEN}[3]${NC} Kill Processes on Port 80"
        echo -e "  ${GREEN}[4]${NC} Kill Processes on Port 443"
        echo -e "  ${GREEN}[5]${NC} Restart Backend Service"
        echo -e "  ${GREEN}[6]${NC} Restart Nginx Service"
        echo -e "  ${GREEN}[7]${NC} Restart Database Service"
        echo -e "  ${GREEN}[8]${NC} Check Configuration"
        echo ""
        echo -e "  ${RED}[0]${NC} Back to Main Menu"
        echo ""
        read -p "Select option: " choice
        
        case $choice in
            1)
                print_info "Fixing file permissions..."
                sudo chown -R $USER:$USER .
                chmod +x *.sh
                print_success "Permissions fixed!"
                pause
                ;;
            2)
                print_info "Configuring firewall..."
                sudo ufw allow 80/tcp
                sudo ufw allow 443/tcp
                sudo ufw status
                pause
                ;;
            3)
                print_info "Killing processes on port 80..."
                sudo lsof -ti:80 | xargs -r sudo kill -9
                print_success "Port 80 cleared!"
                pause
                ;;
            4)
                print_info "Killing processes on port 443..."
                sudo lsof -ti:443 | xargs -r sudo kill -9
                print_success "Port 443 cleared!"
                pause
                ;;
            5)
                docker compose restart backend
                print_success "Backend restarted!"
                pause
                ;;
            6)
                docker compose restart nginx
                print_success "Nginx restarted!"
                pause
                ;;
            7)
                docker compose restart postgres
                print_success "Database restarted!"
                pause
                ;;
            8)
                echo "Environment Configuration:"
                cat .env | grep -v "^#" | grep .
                pause
                ;;
            0)
                return
                ;;
            *)
                print_error "Invalid option"
                sleep 1
                ;;
        esac
    done
}

